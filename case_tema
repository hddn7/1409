let opcao = prompt(
    "Escolha uma área de tecnologia:\n" +
    "desenvolvimento web\n" +
    "banco de dados\n" +
    "segurança da informação\n" +
    "desenvolvimento de jogos\n" +
    "inteligência artificial\n" +
    "redes de computadores"
);

let mensagem;

switch (opcao) {
    case "1":
        mensagem = "Desenvolvimento Web: continue praticando HTML, CSS e JavaScript.";
        break;

    case "2":
        mensagem = "Banco de Dados: continue estudando organização e manipulação de dados.";
        break;

    case "3":
        mensagem = "Segurança da Informação: explore formas de proteger sistemas e informações.";
        break;

    case "4":
        mensagem = "Desenvolvimento de Jogos: pratique programação e criação de jogos.";
        break;

    case "5":
        mensagem = "Inteligência Artificial: continue explorando programação e novas tecnologias.";
        break;

    case "6":
        mensagem = "Redes de Computadores: aprenda mais sobre comunicação entre computadores.";
        break;

    default:
        mensagem = "Opção inválida, tente novamente";
}

document.write(mensagem);
